# =============================================================================
# Environment Variables
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

APP_NAME="Backend API"
ENV="development"
DEBUG="True"
SSL_MODE="disable"
BG_JOB_ISOLATED_LOOPS=true

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key_here

# E2B Sandbox API Key
E2B_API_KEY=e2b_your_e2b_api_key_here
E2B_TEMPLATE_ID=react-fast-mongo-pre-v0

# OpenAI API Key (for embeddings and fallback)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# =============================================================================
# OPTIONAL API KEYS
# =============================================================================

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
PARALLEL_API_KEY=your_parallel_ai_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_key_here
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=false

# =============================================================================
# POSTGRESQL (User/Project Metadata)
# =============================================================================

DATABASE_URL=postgresql://username:password@host-pooler.region.provider.com/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://username:password@host.region.provider.com/database?sslmode=require

# =============================================================================
# MONGODB (Checkpoints & Memory)
# =============================================================================

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=checkpointing_db
MONGODB_CHECKPOINT_COLLECTION=checkpoints
MONGODB_WRITES_COLLECTION=checkpoint_writes
MONGODB_STORE_COLLECTION=memories
ENABLE_SEMANTIC_SEARCH=true

# =============================================================================
# REDIS (Optional)
# =============================================================================

REDIS_URL=redis://default:password@host:port

# =============================================================================
# SERVER
# =============================================================================

HOST=0.0.0.0
PORT=8000
RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
